# Point this at the SAME database the main Phantasm site uses.
# Use a pooled/serverless-friendly connection string (Neon, Supabase, or
# Vercel Postgres all provide one) — Vercel functions run many concurrent
# instances, each opening its own small connection pool.
DATABASE_URL=

# Only used for local (non-Vercel) development if DATABASE_URL isn't set.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=phantasm_pass
PGDATABASE=phantasm
PGSSL=false

# Max connections opened per function instance's pool. Keep this low.
PG_POOL_MAX=5

# Only used by server.js for local development (npm start / npm run start:local).
PORT=4100

# Comma-separated list of origins allowed to call the API. Leave blank —
# on Vercel the frontend and API share one domain, so CORS isn't needed.
CORS_ORIGIN=

# Shared secret required to view /admin.html and the admin API routes.
# Set this in the Vercel project's Environment Variables settings.
ADMIN_KEY=change-me
